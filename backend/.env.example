# Gemini API Key (get yours from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Tesseract OCR path override (if not on PATH on Windows)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Database Connection (Defaults to SQLite in backend/source2study.db)
DATABASE_URL=sqlite:///./source2study.db
